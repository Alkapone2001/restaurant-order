# Lidhja e databazes per zhvillim lokal.
# Vercel mund te jape POSTGRES_URL automatikisht; DATABASE_URL punon gjithashtu.
DATABASE_URL=postgres://user:password@localhost:5432/restaurant_order

# Emri qe shfaqet ne aplikacion dhe vendoset ne database te re.
RESTAURANT_NAME=Porosite e Restorantit

# Per Postgres lokal pa SSL perdor false. Per host te jashtem lere bosh ose true.
PGSSL=false

# Porta lokale e serverit.
PORT=3000

# E nevojshme per njoftime Web Push ne sfond.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
