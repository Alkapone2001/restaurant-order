[Unit]
Description=Restaurant Order Node.js application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=restaurant-order
Group=restaurant-order
WorkingDirectory=/opt/restaurant-order
EnvironmentFile=/etc/restaurant-order.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/restaurant-order/server.js
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/restaurant-order
StandardOutput=journal
StandardError=journal
SyslogIdentifier=restaurant-order

[Install]
WantedBy=multi-user.target
